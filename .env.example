# OpenMate Environment Configuration

# GitHub Personal Access Token (optional for public repositories, recommended for higher rate limits)
GITHUB_TOKEN=

# Backboard API Key for repository analysis and assistant reasoning
BACKBOARD_API_KEY=

# Backboard LLM Provider and Model Configuration (Defaults to Google Gemma 3 27B open-weight model)
BACKBOARD_MODEL_PROVIDER=openrouter
BACKBOARD_MODEL_NAME=google/gemma-3-27b-it
BACKBOARD_TIMEOUT_MS=60000
