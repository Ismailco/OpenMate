# OpenMate Environment Configuration

# GitHub Personal Access Token (optional for public repositories, recommended for higher rate limits)
GITHUB_TOKEN=

# Backboard API Key for repository analysis and assistant reasoning
BACKBOARD_API_KEY=

# Backboard LLM Provider and Model Configuration (Defaults to Google Gemma 3 27B open-weight model)
BACKBOARD_MODEL_PROVIDER=openrouter
BACKBOARD_MODEL_NAME=google/gemma-3-27b-it
BACKBOARD_TIMEOUT_MS=60000

# Secret used to sign conversation tokens for Ask OpenMate (min 32 chars, HMAC-SHA-256)
OPENMATE_CHAT_SIGNING_SECRET=

# Sentry Agent Tracing & Production Observability (optional; application operates normally when unset)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0

# Optional Sentry Source Map Upload Credentials (build-time only; never exposed to browser)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
